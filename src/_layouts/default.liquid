<!doctype html>
<html lang="{{ site.locale }}">
  <head>
    {% render "head", metadata: site.metadata, title: data.title %}
  </head>
  <body data-page="{{ data.page_id }}">
    {% render "scroll_progress" %}
    {% render "navbar", metadata: site.metadata, resource: resource, page_id: data.page_id %}
    {% render "mobile_bottom_bar" %}
    <main class="main-content">
      {{ content }}
    </main>
    {% render "back_to_top" %}
    {% render "footer", metadata: site.metadata, page_id: data.page_id %}
  </body>
</html>
