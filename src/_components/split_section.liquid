<section class="split-section {{ bg_class }}">
  <div class="split-grid{% if reverse == true or reverse == 'true' %} reverse{% endif %}">
    <div class="split-content">
      {% if badge %}
        <div class="split-badge">{{ badge }}</div>
      {% endif %}
      <h2>{{ heading }}</h2>
      {% if body %}
        <p>{{ body }}</p>
      {% endif %}
      {% if checklist %}
        <div class="checklist">
          {% assign items = checklist | split: "|" %}
          {% for item in items %}
            <div class="checklist-item">
              <div class="check-dot {{ dot_color | default: 'peach' }}"></div>
              <p>{{ item | strip }}</p>
            </div>
          {% endfor %}
        </div>
      {% endif %}
    </div>
    <div class="split-image">
      <img src="{{ image_url }}" alt="{{ image_alt }}">
    </div>
  </div>
</section>
