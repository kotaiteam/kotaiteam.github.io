<section class="cta-section{% if extra_class %} {{ extra_class }}{% endif %}"{% if section_id %} id="{{ section_id }}"{% endif %}>
  <div class="container cta-content">
    {% if icon %}
    <div class="cta-crown">
      <i data-lucide="{{ icon }}"></i>
    </div>
    {% endif %}
    <h2{% if title_id %} id="{{ title_id }}"{% endif %}>{{ title }}</h2>
    <p{% if body_id %} id="{{ body_id }}"{% endif %}>{{ body }}</p>
    <a href="{{ button_href }}" class="btn btn-cta">{{ button_text }}</a>
  </div>
</section>
