<!-- Digital Services -->
<section id="digitalServicesContent" class="services-content">
  <div class="container">
    <div class="services-grid">
      {% for item in services.digital.services %}
        <div class="service-card">
          <div class="service-icon">
            <i data-lucide="{{ item.icon }}"></i>
          </div>
          <h3>{{ item.title }}</h3>
          <ul class="service-points">
            {% for point in item.points %}
              <li><span class="bullet"></span>{{ point }}</li>
            {% endfor %}
          </ul>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

<!-- Fractional Services -->
<section id="fractionalServicesContent" class="services-content" style="display:none;">
  <div class="container">
    <div class="fractional-roles-list">
      {% for role in services.fractional.roles %}
        <div class="fractional-role-card">
          <div class="role-header">
            <div class="service-icon">
              <i data-lucide="{{ role.icon }}"></i>
            </div>
            <div class="role-body">
              <h3>{{ role.title }}</h3>
              <div class="role-columns">
                <div>
                  <h4>Responsibilities</h4>
                  <ul class="service-points">
                    {% for r in role.responsibilities %}
                      <li><span class="bullet"></span>{{ r }}</li>
                    {% endfor %}
                  </ul>
                </div>
                <div class="role-info-box">
                  <div>
                    <h4>Ideal For</h4>
                    <p>{{ role.ideal_for }}</p>
                  </div>
                  <div>
                    <h4>Typical Engagement</h4>
                    <p>{{ role.engagement }}</p>
                  </div>
                  <div>
                    <h4>KPIs Delivered</h4>
                    <p>{{ role.kpis }}</p>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</section>
