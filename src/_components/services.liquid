<!-- Digital Services -->
<section id="digitalServicesContent" class="section">
  <div class="container">
    <div class="block has-text-centered mb-6 section-header">
      <h2 id="servicesTitle" class="title is-3">{{ services.digital.title }}</h2>
      <p id="servicesSubtitle" class="subtitle is-5">{{ services.digital.subtitle }}</p>
    </div>
    <div class="columns is-multiline">
      {% for item in services.digital.services %}
        <div class="column is-half-tablet is-one-quarter-desktop service-card">
          <div class="card" style="height:100%;">
            <div class="card-content">
              <div class="card-icon-wrapper peach-bg mb-4">
                <i data-lucide="{{ item.icon }}" style="width:24px;height:24px;"></i>
              </div>
              <p class="title is-5 mb-3">{{ item.title }}</p>
              <ul style="list-style:none;padding:0;margin:0;">
                {% for point in item.points %}
                  <li class="is-flex is-align-items-center mb-2" style="gap:0.6rem;">
                    <span class="check-dot peach"></span>
                    <span style="font-size:0.9rem;color:#555;">{{ point }}</span>
                  </li>
                {% endfor %}
              </ul>
            </div>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

<!-- Fractional Services -->
<section id="fractionalServicesContent" class="section" style="display:none;">
  <div class="container">
    {% for role in services.fractional.roles %}
      <div class="box mb-5 fractional-role-card">
        <div class="columns">
          <div class="column is-narrow" style="display:flex;align-items:flex-start;padding-top:0.25rem;">
            <div class="card-icon-wrapper peach-bg">
              <i data-lucide="{{ role.icon }}" style="width:24px;height:24px;"></i>
            </div>
          </div>
          <div class="column">
            <p class="title is-4 mb-4">{{ role.title }}</p>
            <div class="columns">
              <div class="column">
                <p class="role-label mb-3">Responsibilities</p>
                <ul style="list-style:none;padding:0;margin:0;">
                  {% for r in role.responsibilities %}
                    <li class="is-flex is-align-items-center mb-2" style="gap:0.6rem;">
                      <span class="check-dot slate"></span>
                      <span style="font-size:0.9rem;color:#555;">{{ r }}</span>
                    </li>
                  {% endfor %}
                </ul>
              </div>
              <div class="column">
                <div class="box role-info-box">
                  <p class="role-label">Ideal For</p>
                  <p class="mb-3" style="font-size:0.9rem;">{{ role.ideal_for }}</p>
                  <p class="role-label">Typical Engagement</p>
                  <p class="mb-3" style="font-size:0.9rem;">{{ role.engagement }}</p>
                  <p class="role-label">KPIs Delivered</p>
                  <p style="font-size:0.9rem;">{{ role.kpis }}</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    {% endfor %}
  </div>
</section>
