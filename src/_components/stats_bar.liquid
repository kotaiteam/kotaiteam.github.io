<!-- Digital Stats -->
<div id="statsDigital" class="stats-panel">
  <section class="stats-section">
    <div class="container">
      <div class="stats-grid">
        <div class="stat-item">
          <div class="stat-icon-wrapper">
            <i data-lucide="cloud" style="color:var(--kotai-slate);"></i>
          </div>
          <div class="stat-count">200+</div>
          <div class="stat-label">Projects Delivered</div>
        </div>
        <div class="stat-item">
          <div class="stat-icon-wrapper">
            <i data-lucide="brain" style="color:var(--kotai-slate);"></i>
          </div>
          <div class="stat-count">50+</div>
          <div class="stat-label">AI Models Deployed</div>
        </div>
        <div class="stat-item">
          <div class="stat-icon-wrapper">
            <i data-lucide="database" style="color:var(--kotai-slate);"></i>
          </div>
          <div class="stat-count">10PB+</div>
          <div class="stat-label">Data Processed</div>
        </div>
        <div class="stat-item">
          <div class="stat-icon-wrapper">
            <i data-lucide="check-circle" style="color:var(--kotai-slate);"></i>
          </div>
          <div class="stat-count">1M+</div>
          <div class="stat-label">Tasks Automated</div>
        </div>
      </div>
    </div>
  </section>
</div>

