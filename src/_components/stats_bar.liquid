<!-- Digital Stats -->
<div id="statsDigital" class="stats-panel">
  <section class="section" style="background:var(--kotai-white);border-bottom:1px solid var(--kotai-border);">
    <div class="container">
      <div class="columns is-vcentered has-text-centered">
        <div class="column stat-item">
          <div class="stat-icon-wrapper mx-auto">
            <i data-lucide="cloud" style="width:20px;height:20px;color:var(--kotai-slate);"></i>
          </div>
          <p class="stat-count">200+</p>
          <p class="stat-label">Projects Delivered</p>
        </div>
        <div class="column stat-item">
          <div class="stat-icon-wrapper mx-auto">
            <i data-lucide="brain" style="width:20px;height:20px;color:var(--kotai-slate);"></i>
          </div>
          <p class="stat-count">50+</p>
          <p class="stat-label">AI Models Deployed</p>
        </div>
        <div class="column stat-item">
          <div class="stat-icon-wrapper mx-auto">
            <i data-lucide="database" style="width:20px;height:20px;color:var(--kotai-slate);"></i>
          </div>
          <p class="stat-count">10PB+</p>
          <p class="stat-label">Data Processed</p>
        </div>
        <div class="column stat-item">
          <div class="stat-icon-wrapper mx-auto">
            <i data-lucide="check-circle" style="width:20px;height:20px;color:var(--kotai-slate);"></i>
          </div>
          <p class="stat-count">1M+</p>
          <p class="stat-label">Tasks Automated</p>
        </div>
      </div>
    </div>
  </section>
</div>

<!-- Fractional Stats -->
<div id="statsFractional" class="stats-panel" style="display:none;">
  <section class="section" style="background:var(--kotai-white);border-bottom:1px solid var(--kotai-border);">
    <div class="container">
      <div class="columns is-vcentered has-text-centered">
        <div class="column stat-item">
          <div class="stat-icon-wrapper mx-auto">
            <i data-lucide="award" style="width:20px;height:20px;color:var(--kotai-slate);"></i>
          </div>
          <p class="stat-count">20+</p>
          <p class="stat-label">Years Avg Experience</p>
        </div>
        <div class="column stat-item">
          <div class="stat-icon-wrapper mx-auto">
            <i data-lucide="trending-up" style="width:20px;height:20px;color:var(--kotai-slate);"></i>
          </div>
          <p class="stat-count">150%</p>
          <p class="stat-label">Average Growth Impact</p>
        </div>
        <div class="column stat-item">
          <div class="stat-icon-wrapper mx-auto">
            <i data-lucide="star" style="width:20px;height:20px;color:var(--kotai-slate);"></i>
          </div>
          <p class="stat-count">98%</p>
          <p class="stat-label">Client Satisfaction</p>
        </div>
        <div class="column stat-item">
          <div class="stat-icon-wrapper mx-auto">
            <i data-lucide="users" style="width:20px;height:20px;color:var(--kotai-slate);"></i>
          </div>
          <p class="stat-count">300+</p>
          <p class="stat-label">Executives Placed</p>
        </div>
      </div>
    </div>
  </section>
</div>
