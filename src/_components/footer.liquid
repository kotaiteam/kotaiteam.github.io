<footer class="site-footer">
  <div class="footer-accent"></div>
  <div class="footer-pattern"></div>
  <div class="footer-container">

    <div class="footer-grid">

      <div class="footer-brand">
        <a href="{{ '/' | relative_url }}" class="footer-logo-btn" id="footerLogoBtn">
          <img src="{{ '/images/' | append: metadata.logo | relative_url }}" alt="KOTAI" class="footer-logo">
        </a>
        <p class="footer-tagline">{{ metadata.tagline }}</p>
        <div class="footer-contact-info">
          <div class="footer-contact-item">
            <i data-lucide="mail" class="footer-icon"></i>
            <a href="mailto:{{ metadata.email }}">{{ metadata.email }}</a>
          </div>
          <div class="footer-contact-item">
            <i data-lucide="map-pin" class="footer-icon"></i>
            <span>Global Presence</span>
          </div>
        </div>
      </div>

      <div class="footer-col">
        <h4>Kotai Digital</h4>
        <ul>
          <li><a href="{{ '/services/' | relative_url }}">Digital Transformation</a></li>
          <li><a href="{{ '/services/' | relative_url }}">AI Adoption</a></li>
          <li><a href="{{ '/services/' | relative_url }}">Cloud Solutions</a></li>
          <li><a href="{{ '/services/' | relative_url }}">Development</a></li>
        </ul>
      </div>

      <div class="footer-col">
        <h4>Kotai Fractional</h4>
        <ul>
          <li><a href="{{ '/services/' | relative_url }}">Fractional CTO</a></li>
          <li><a href="{{ '/services/' | relative_url }}">Fractional CMO</a></li>
          <li><a href="{{ '/services/' | relative_url }}">Fractional COO</a></li>
          <li><a href="{{ '/services/' | relative_url }}">Executive Leadership</a></li>
        </ul>
      </div>

      <div class="footer-col">
        <h4>Company</h4>
        <ul>
          <li><a href="{{ '/about/' | relative_url }}">About Us</a></li>
          <li><a href="{{ '/contact/' | relative_url }}">Contact</a></li>
          <li>
            <a href="{{ metadata.linkedin_url }}" target="_blank" rel="noopener noreferrer" class="footer-linkedin">
              <i data-lucide="linkedin" class="footer-icon"></i>
              LinkedIn
            </a>
          </li>
        </ul>
      </div>

    </div>

    <div class="footer-bottom">
      <p>&copy; 2026 KOTAI. All rights reserved.</p>
      <div class="footer-links">
        <a href="#">Privacy Policy</a>
        <a href="#">Terms of Service</a>
      </div>
    </div>

  </div>
</footer>
