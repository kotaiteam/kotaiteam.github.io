<section class="contact-section">
  <div class="container">
    <div class="contact-grid">

      <!-- Contact Info -->
      <div class="contact-info">
        <h2>Get in Touch</h2>
        <p class="contact-intro">We're excited to learn about your business and explore how we can partner together.</p>

        <div class="contact-items">
          <div class="contact-item">
            <div class="contact-icon peach"><i data-lucide="mail"></i></div>
            <div>
              <h3>Email</h3>
              <a href="mailto:{{ metadata.email }}">{{ metadata.email }}</a>
            </div>
          </div>
          <!-- 
          <div class="contact-item">
            <div class="contact-icon peach"><i data-lucide="phone"></i></div>
            <div>
              <h3>Phone</h3>
              <a href="{{ metadata.phone }}">{{ metadata.phone }}</a>
            </div>
          </div>
          -->
          <div class="contact-item">
            <div class="contact-icon peach"><i data-lucide="map-pin"></i></div>
            <div>
              <h3>Office</h3>
              <p>{{ metadata.address }}</p>
            </div>
          </div>
          <div class="contact-item">
            <div class="contact-icon slate"><i data-lucide="linkedin"></i></div>
            <div>
              <h3>LinkedIn</h3>
              <a href="{{ metadata.linkedin_url }}" target="_blank" rel="noopener noreferrer">linkedin.com/company/kotai</a>
            </div>
          </div>
        </div>

        <!-- Calendar Booking -->
        <div class="calendar-box">
          <div class="calendar-header">
            <i data-lucide="calendar"></i>
            <h3>Book a Meeting</h3>
          </div>
          <p>Schedule a 30-minute introductory consultation meeting to discuss your needs.</p>
          <a href="{{ metadata.bookings_link }}" target="_blank" rel="noopener noreferrer" class="btn btn-calendar">View Calendar</a>
        </div>
      </div>

      <!-- Contact Form -->
      <div class="contact-form-wrapper">
        <form id="contactForm">
          <div class="form-row">
            <div class="form-group">
              <label for="contact-name">Name *</label>
              <input type="text" id="contact-name" name="name" required placeholder="John Doe">
            </div>
            <div class="form-group">
              <label for="contact-company">Company *</label>
              <input type="text" id="contact-company" name="company" required placeholder="Company Name">
            </div>
          </div>
          <div class="form-group">
            <label for="contact-role">Role *</label>
            <input type="text" id="contact-role" name="role" required placeholder="CEO, CTO, etc.">
          </div>
          <div class="form-row">
            <div class="form-group">
              <label for="contact-email">Email *</label>
              <input type="email" id="contact-email" name="email" required placeholder="john@company.com">
            </div>
            <div class="form-group">
              <label for="contact-phone">Phone</label>
              <input type="tel" id="contact-phone" name="phone" placeholder="+1 (555) 123-4567">
            </div>
          </div>
          <div class="form-group">
            <label for="contact-service">Service Interested In *</label>
            <select id="contact-service" name="service" required>
              <option value="">Select a service</option>
              <option value="digital">Kotai Digital</option>
              <option value="fractional">Kotai Fractional</option>
              <option value="both">Both</option>
            </select>
          </div>
          <div class="form-group">
            <label for="contact-budget">Project Budget Range</label>
            <select id="contact-budget" name="budget">
              <option value="">Select budget range</option>
              <option value="50k-100k">$50K - $100K</option>
              <option value="100k-250k">$100K - $250K</option>
              <option value="250k-500k">$250K - $500K</option>
              <option value="500k+">$500K+</option>
            </select>
          </div>
          <div class="form-group">
            <label for="contact-message">Message *</label>
            <textarea id="contact-message" name="message" required rows="5" placeholder="Tell us about your project or needs..."></textarea>
          </div>
          <button type="submit" class="btn btn-submit">Send Message</button>
        </form>
      </div>

    </div>
  </div>
</section>
